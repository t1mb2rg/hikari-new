  "cards": [
    {
      "dot": "cyan",
      "title": "生命周期与收敛",
      "items": [
        "插件状态机只有五态：waiting / starting / active / stopping / failed",
        "loadPlugin 先校验 definition，再用 config.parse 解析配置；失败则完全不注册",
        "reconcile 循环收敛：requires 未满足停在 waiting，Provider 出现后自动激活",
        "unloadPlugin 先递归停用依赖方（deactivateTree），再释放 Provider 自身",
        "shutdown 按加载逆序逐个卸载"
      ]
    },
    {
      "dot": "emerald",
      "title": "契约与依赖护栏",
      "items": [
        "ServiceContract / EventContract 以 id@version 为键，由 defineService / defineEvent 产出冻结对象",
        "Consumer 只能 get 自己在 requires 声明的 Service，否则抛 UndeclaredServiceDependencyError",
        "Provider 只能 provide 自己在 provides 声明的 Service，否则抛 UndeclaredServiceProviderError",
        "声明了 provides 却没在 setup 中真正注册，激活以 MissingDeclaredServiceError 失败",
        "一个契约同时只允许一个活动 Provider，重复注册抛 ServiceAlreadyProvidedError"
      ]
    },
    {
      "dot": "amber",
      "title": "资源归属与清理",
      "items": [
        "Service 注册与 Event 订阅返回的 Cleanup 都登记进该 Plugin 的 EffectScope",
        "setup 返回的 Cleanup 同样由 scope.defer 接管",
        "dispose 逆序执行；单个清理失败不会阻止其余资源释放，最后汇总为 AggregateError",
        "setup 失败时先标记 failed，再把 setup 错误与清理错误合并为 AggregateError",
        "EventBus.emit 用 Promise.allSettled 等待全部订阅者，有失败则抛 AggregateError"
      ]
    },
    {
      "dot": "rose",
      "title": "Phase 1 边界：以下均未实现",
      "items": [
        "无跨 Runtime 通信、无网络 / RPC、无远程 Provider",
        "无 Capability 第二注册表、无 Provider 智能选择、无全局状态中心",
        "无 Chronicle / Memory / World / Goal 领域实现",
        "无完整权限系统、无音视频流式资源框架",
        "只有硬依赖，没有可选 Service 依赖；failed 不自动重试，需卸载后重新加载"
      ]
    }
  ]
